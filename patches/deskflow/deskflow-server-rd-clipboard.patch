+XdpSession *PortalInputCapture::clipboardSession() const
+{
+#ifdef HAVE_LIBPORTAL_CLIPBOARD
+  if (m_clipboardSession && xdp_session_is_clipboard_enabled(m_clipboardSession))
+    return m_clipboardSession;
+#endif
+  return m_session ? xdp_input_capture_session_get_session(m_session) : nullptr;
+}
+
+void PortalInputCapture::initClipboardSession()
+{
+#ifdef HAVE_LIBPORTAL_CLIPBOARD
+  if (m_clipboardSession)
+    return;
+
+  // libportal g_strdup()s the restore token, so a temporary is fine here.
+  const auto token = Settings::value(Settings::Server::XdpClipboardRestoreToken).toByteArray();
+
+  LOG_DEBUG("creating remote desktop session for clipboard access");
+  xdp_portal_create_remote_desktop_session_full(
+      m_portal, XDP_DEVICE_NONE, XDP_OUTPUT_NONE, XDP_REMOTE_DESKTOP_FLAG_NONE, XDP_CURSOR_MODE_HIDDEN,
+      XDP_PERSIST_MODE_PERSISTENT, token.isEmpty() ? nullptr : token.constData(),
+      nullptr, // cancellable
+      [](GObject *obj, GAsyncResult *res, gpointer data) {
+        static_cast<PortalInputCapture *>(data)->handleClipboardSessionCreated(obj, res);
+      },
+      this
+  );
+#endif
+}
+
+void PortalInputCapture::handleClipboardSessionCreated(GObject *object, GAsyncResult *res)
+{
+#ifdef HAVE_LIBPORTAL_CLIPBOARD
+  g_autoptr(GError) error = nullptr;
+  auto session = xdp_portal_create_remote_desktop_session_finish(XDP_PORTAL(object), res, &error);
+  if (!session) {
+    LOG_WARN("clipboard remote desktop session failed, continuing without clipboard: %s", error->message);
+    return;
+  }
+
+  m_clipboardSession = session;
+  xdp_session_request_clipboard(session);
+  m_clipboardTransferSignal =
+      g_signal_connect(G_OBJECT(session), "selection-transfer", G_CALLBACK(selectionTransfer), this);
+
+  xdp_session_start(
+      session,
+      nullptr, // parent
+      nullptr, // cancellable
+      [](GObject *obj, GAsyncResult *res, gpointer data) {
+        static_cast<PortalInputCapture *>(data)->handleClipboardSessionStarted(obj, res);
+      },
+      this
+  );
+#else
+  (void)object;
+  (void)res;
+#endif
+}
+
+void PortalInputCapture::handleClipboardSessionStarted(GObject *object, GAsyncResult *res)
+{
+#ifdef HAVE_LIBPORTAL_CLIPBOARD
+  g_autoptr(GError) error = nullptr;
+  auto session = XDP_SESSION(object);
+  if (!xdp_session_start_finish(session, res, &error)) {
+    LOG_WARN("clipboard remote desktop session did not start, continuing without clipboard: %s", error->message);
+    if (m_clipboardTransferSignal != 0) {
+      g_signal_handler_disconnect(session, m_clipboardTransferSignal);
+      m_clipboardTransferSignal = 0;
+    }
+    g_clear_object(&m_clipboardSession);
+    return;
+  }
+
+  if (char *token = xdp_session_get_restore_token(session)) {
+    Settings::setValue(Settings::Server::XdpClipboardRestoreToken, QString(token));
+    g_free(token);
+  }
+
+  if (xdp_session_is_clipboard_enabled(session))
+    LOG_INFO("clipboard enabled via remote desktop session");
+  else
+    LOG_WARN("remote desktop session started but the backend did not enable the clipboard");
+#else
+  (void)object;
+  (void)res;
+#endif
+}
