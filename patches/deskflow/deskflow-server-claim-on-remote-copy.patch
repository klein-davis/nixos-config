+void PortalInputCapture::claimClipboard() const
+{
+#ifdef HAVE_LIBPORTAL_CLIPBOARD
+  XdpSession *session = clipboardSession();
+  if (!session || !xdp_session_is_clipboard_enabled(session)) {
+    LOG_DEBUG("portal input capture clipboard not enabled, cannot claim");
+    return;
+  }
+  claimClipboardOwnership(session);
+#endif
+}
