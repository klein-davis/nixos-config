+            Stream(
+                cast.thread.node_id(),
+                StreamProperties {
+                    position: Some(cast.position),
+                    size: cast.size,
+                    source_type: SourceType::Monitor,
+                    ..Default::default()
+                },
+            )
+        })
+        .collect()
+}
