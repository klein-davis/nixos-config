+// Some monitors drop HPD for a couple of seconds a while after losing signal
+// (i.e. after DPMS off) and then reconnect. The reconnect creates a fresh
+// CMonitor, which would be lit (m_dpmsStatus defaults to true), so remember
+// which outputs were DPMS-off when their connector vanished and bring them
+// back dark if they return shortly after.
+static std::unordered_map<std::string, std::chrono::steady_clock::time_point> s_dpmsOffAtDisconnect;
+static constexpr std::chrono::seconds                                         DPMS_OFF_REMEMBER{30};
+
 void CMonitor::onConnect(bool noRule) {
     Event::bus()->m_events.monitor.preAdded.emit(m_self.lock());
     CScopeGuard x = {[]() { State::monitorLayoutController()->arrange(); }};
@@ -261,12 +272,27 @@
     // get monitor rule that matches
     auto monitorRule = Config::monitorRuleMgr()->get(m_self.lock());
 
+    bool keepDpmsOff = false;
+    if (const auto IT = s_dpmsOffAtDisconnect.find(m_name); IT != s_dpmsOffAtDisconnect.end()) {
+        keepDpmsOff = std::chrono::steady_clock::now() - IT->second < DPMS_OFF_REMEMBER;
+        s_dpmsOffAtDisconnect.erase(IT);
+    }
+
+    const auto restoreDpmsOff = [this]() {
+        Log::logger->log(Log::DEBUG, "Output {} reconnected while it was DPMS off, keeping it off", m_name);
+        m_dpmsStatus = false;
+        m_dpmsBlackOpacity->setValueAndWarp(1.F);
+        m_events.dpmsChanged.emit();
+    };
+
     if (m_enabled && !monitorRule.m_disabled) {
